{
  "name": "digitalbank-landing-page",
  "version": "1.0.0",
  "description": "Frontend Mentor - Digitalbank landing page",
  "scripts": {
    "watch:css": "sass --watch scss/style.scss css/style.css",
    "watch:ts": "tsc --watch",
    "build:css": "sass scss/style.scss css/style.css --no-source-map",
    "build:css:min": "sass scss/style.scss css/style.css --style=compressed --no-source-map",
    "build:ts": "tsc",
    "build": "npm run build:css && npm run build:ts"
  },
  "author": "Thomas Bezille",
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.60.0",
    "sass": "^1.100.0",
    "typescript": "^6.0.3"
  }
}
